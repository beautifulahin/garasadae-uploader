#!/bin/zsh
# 가라사대 업로더 — 처음 한 번 여는 도우미
# 공증(애플 심사)을 받지 않은 개인 배포 프로그램이라 맥이 막습니다.
# 이 파일은 앱에 붙은 "인터넷에서 받음" 표시만 떼어내고 앱을 엽니다.
# 앱을 지우거나 옮기지 않습니다.

여기=${0:A:h}
앱이름="가라사대 업로더.app"

echo "────────────────────────────────────────"
echo " 가라사대 업로더 — 처음 한 번 여는 도우미"
echo "────────────────────────────────────────"
echo

앱=""
if [ -d "$여기/$앱이름" ]; then
  앱="$여기/$앱이름"
elif [ -d "/Applications/$앱이름" ]; then
  앱="/Applications/$앱이름"
fi

if [ -z "$앱" ]; then
  echo "❌ 「$앱이름」 을 찾지 못했습니다."
  echo
  echo "   이 파일(열기.command)과 앱이 같은 폴더에 있어야 합니다."
  echo "   압축을 푼 폴더 안을 확인해 주세요."
  echo "   앱을 응용 프로그램 폴더로 옮기셨다면 그대로 두셔도 됩니다 —"
  echo "   그때는 이 파일을 다시 더블클릭하면 찾아냅니다."
  echo
  echo "   찾아본 곳:"
  echo "     $여기/$앱이름"
  echo "     /Applications/$앱이름"
  echo
  echo "창을 닫으셔도 됩니다."
  exit 1
fi

echo "① 앱을 찾았습니다:"
echo "   $앱"
echo

echo "② 「인터넷에서 받음」 표시를 떼는 중…"
if xattr -dr com.apple.quarantine "$앱" 2>/dev/null; then
  echo "   ↳ 되었습니다."
else
  echo "   ⚠️ 표시를 떼지 못했습니다."
  echo "      앱이 다른 사람 계정의 폴더에 있으면 이럴 수 있습니다."
  echo "      앱을 응용 프로그램 폴더로 옮긴 뒤 다시 해 보세요."
fi
echo

echo "③ 앱을 여는 중…"
if open "$앱"; then
  echo "   ↳ 열렸습니다. 잠시 뒤 브라우저에 설정 화면이 뜹니다."
  echo
  echo "   다음부터는 앱을 그냥 더블클릭하면 됩니다."
else
  echo "   ❌ 앱이 열리지 않았습니다."
  echo
  echo "   앱을 한 번 더블클릭해 보세요. 「열지 않음」 창이 뜨면"
  echo "   [휴지통으로 이동] 을 누르지 마시고 [완료] 를 누른 뒤,"
  echo "   시스템 설정 → 개인정보 보호 및 보안 을 열고 아래로 내려"
  echo "   [무시하고 열기] 를 눌러 주세요."
fi

echo
echo "창을 닫으셔도 됩니다."
